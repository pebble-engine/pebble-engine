# Resend — required for the contact form server action.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are emailed to.
CONTACT_TO_EMAIL=

# The "From" address. Must be on a verified domain in Resend.
# The default below works for testing only.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Sitemap base URL. Used by app/sitemap.ts.
NEXT_PUBLIC_SITE_URL=https://example.com
