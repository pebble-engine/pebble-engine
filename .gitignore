# secrets — never commit
.env
.mcp.json

# generated output (client sites)
output/

# runtime logs (engine + dev servers)
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Node — Tailwind toolchain for the quiz UI (run `cd ui && npm install` first time)
ui/node_modules/
ui/package-lock.json

# Template build artifacts (Phase 31, 2026-05-20) — every pebble/templates/<id>/
# is a real Next.js project. The customer's instantiated copy installs deps fresh,
# so the templates' own node_modules/.next/.turbo are NEVER committed.
pebble/templates/*/node_modules/
pebble/templates/*/.next/
pebble/templates/*/.turbo/
pebble/templates/*/dist/
pebble/templates/*/out/
pebble/templates/*/next-env.d.ts
pebble/templates/*/tsconfig.tsbuildinfo

# Claude Code internal
.claude/
.superpowers/

# OS
.DS_Store
Thumbs.db
.vercel
.env*.local

# Local-only backups + research bundles (not for git)
.env.bak-*
.notebooklm-bundle/
