# Pebble Marketing Site — local config template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — keys NEVER get committed.

# ─────────────────────────────────────────────────────────────────
# Resend (https://resend.com)
# Powers the waitlist email-capture form.
# ─────────────────────────────────────────────────────────────────

# Your Resend API key — generate at https://resend.com/api-keys
RESEND_API_KEY=

# Where waitlist notifications get sent (your email — likely Pebble Gmail)
WAITLIST_TO_EMAIL=

# What address waitlist notifications appear to come from.
# For testing: leave as "onboarding@resend.dev" (Resend's shared sender).
# For production: verify your domain at https://resend.com/domains
# and use something like "waitlist@getpebble.net"
WAITLIST_FROM_EMAIL=onboarding@resend.dev

# Optional: a Resend Audience ID (https://resend.com/audiences) —
# if set, waitlist signups also get added to your audience so you
# can email them later.
WAITLIST_AUDIENCE_ID=
