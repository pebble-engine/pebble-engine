# Pebble Engine — config
# Copy this file to .env and fill in your key(s).
# .env is loaded automatically by pebble_engine.py at startup.

# ─────────────────────────────────────────────────────────────────
# PROVIDER SELECTION
# Default is gemini. Switch to anthropic for Claude Opus builds.
# ─────────────────────────────────────────────────────────────────
PEBBLE_PROVIDER=gemini


# ─────────────────────────────────────────────────────────────────
# GEMINI (default)
# Get a key at https://aistudio.google.com/apikey
# Google AI Ultra users: your subscription gives you higher rate limits.
# ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=


# ─────────────────────────────────────────────────────────────────
# ANTHROPIC (premium / second-opinion option)
# Get a key at https://console.anthropic.com/settings/keys
# Swap in for high-stakes client work: PEBBLE_PROVIDER=anthropic
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────
# PEXELS (optional — industry-relevant placeholder photos + hero video)
# Free API key at https://www.pexels.com/api/
# Without this, Picsum Photos seed URLs are used instead (generic, no key needed).
# ─────────────────────────────────────────────────────────────────
PEXELS_API_KEY=


# ─────────────────────────────────────────────────────────────────
# FIGMA (optional — pulls metadata when the brief includes a Figma URL)
# Personal access token at https://www.figma.com/developers/api#access-tokens
# Uploaded screenshots in the quiz do NOT need this token.
# ─────────────────────────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=


# ─────────────────────────────────────────────────────────────────
# MODEL OVERRIDE (optional)
# Leave blank to use the recommended default for your chosen provider.
#
# Gemini defaults:
#   gemini-2.5-flash         ← default (fast, capable, free-tier friendly)
#   gemini-2.5-pro           ← higher quality, slower
#
# Anthropic defaults:
#   claude-opus-4-7          ← default (highest quality)
#   claude-sonnet-4-6        ← faster and cheaper
#   claude-haiku-4-5-20251001 ← fastest iteration
# ─────────────────────────────────────────────────────────────────
PEBBLE_MODEL=


# ─────────────────────────────────────────────────────────────────
# POST-BUILD AUTOMATION (feature flags — both off by default for cost protection)
# ─────────────────────────────────────────────────────────────────

# Replace Pexels hero/section photos with Imagen 4 generations after the LLM call.
# Uses the Gemini key. ~8 API calls per build.
PEBBLE_USE_IMAGEN=false

# After the build, run `npm install`, start `next dev` on a free port,
# and capture Playwright screenshots of the rendered site.
# Requires Node and `playwright install chromium`.
PEBBLE_AUTO_RUN=false
