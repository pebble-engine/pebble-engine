# Pebble Engine — config
# Copy this file to .env and fill in your key(s).
# .env is loaded automatically by pebble_engine.py at startup.

# ─────────────────────────────────────────────────────────────────
# PROVIDER SELECTION
# Default is gemini. Switch to anthropic for Claude Opus builds.
# ─────────────────────────────────────────────────────────────────
PEBBLE_PROVIDER=gemini


# ─────────────────────────────────────────────────────────────────
# GEMINI (default)
# Get a key at https://aistudio.google.com/apikey
# Google AI Ultra users: your subscription gives you higher rate limits.
# ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=


# ─────────────────────────────────────────────────────────────────
# ANTHROPIC (premium / second-opinion option)
# Get a key at https://console.anthropic.com/settings/keys
# Swap in for high-stakes client work: PEBBLE_PROVIDER=anthropic
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────
# MODEL OVERRIDE (optional)
# Leave blank to use the recommended default for your chosen provider.
#
# Gemini defaults:
#   gemini-3.1-pro-preview   ← default (best quality, your Ultra model)
#   gemini-3-flash           ← fastest, cheapest, for quick iteration
#
# Anthropic defaults:
#   claude-opus-4-6          ← default (highest quality)
#   claude-sonnet-4-6        ← faster and cheaper
# ─────────────────────────────────────────────────────────────────
PEBBLE_MODEL=
