# Pebble Engine — config
# Copy this file to .env and fill in your key(s).
# .env is loaded automatically by pebble_engine.py at startup.

# ─────────────────────────────────────────────────────────────────
# PROVIDER SELECTION
# Default is gemini. Switch to anthropic for Claude Opus builds.
# ─────────────────────────────────────────────────────────────────
PEBBLE_PROVIDER=gemini


# ─────────────────────────────────────────────────────────────────
# GEMINI (default)
# Get a key at https://aistudio.google.com/apikey
# Google AI Ultra users: your subscription gives you higher rate limits.
# ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=


# ─────────────────────────────────────────────────────────────────
# ANTHROPIC (premium / second-opinion option)
# Get a key at https://console.anthropic.com/settings/keys
# Swap in for high-stakes client work: PEBBLE_PROVIDER=anthropic
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=



# ─────────────────────────────────────────────────────────────────
# FIGMA (optional — pulls metadata when the brief includes a Figma URL)
# Personal access token at https://www.figma.com/developers/api#access-tokens
# Uploaded screenshots in the quiz do NOT need this token.
# ─────────────────────────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=


# ─────────────────────────────────────────────────────────────────
# MODEL OVERRIDE (optional)
# Leave blank to use the recommended default for your chosen provider.
#
# Gemini defaults:
#   gemini-2.5-flash         ← default (fast, capable, free-tier friendly)
#   gemini-2.5-pro           ← higher quality, slower
#
# Anthropic defaults:
#   claude-opus-4-7          ← default (highest quality)
#   claude-sonnet-4-6        ← faster and cheaper
#   claude-haiku-4-5-20251001 ← fastest iteration
# ─────────────────────────────────────────────────────────────────
PEBBLE_MODEL=


# ─────────────────────────────────────────────────────────────────
# POST-BUILD AUTOMATION (feature flags — both off by default for cost protection)
# ─────────────────────────────────────────────────────────────────

# Replace Pexels hero/section photos with Imagen 4 generations after the LLM call.
# Uses the Gemini key. ~8 API calls per build.
PEBBLE_USE_IMAGEN=false

# After the build, run `npm install`, start `next dev` on a free port,
# and capture Playwright screenshots of the rendered site.
# Requires Node and `playwright install chromium`.
PEBBLE_AUTO_RUN=false

# After the build, run pebble.evals; if any checks fail, ask the LLM to
# fix the named failures and re-eval (up to 2 rounds). Adds 10-30 s and
# one more LLM round-trip per failing build.
PEBBLE_AUTO_REPAIR=false


# ─────────────────────────────────────────────────────────────────
# STRIPE (billing) — required if running the Pebble SaaS surface
# (/api/checkout/create-session, /api/billing/portal, /api/internal/stripe-webhook)
#
# Dashboard: https://dashboard.stripe.com/test/apikeys
#   1. Copy the "Secret key"      -> STRIPE_SECRET_KEY      (sk_test_...)
#   2. Copy the "Publishable key" -> STRIPE_PUBLISHABLE_KEY (pk_test_...)
#
# For the webhook secret you have two paths:
#   a) Local dev — run `stripe listen --forward-to localhost:8000/api/internal/stripe-webhook`
#      and paste the `whsec_...` it prints into STRIPE_WEBHOOK_SECRET.
#   b) Production — create the endpoint in Dashboard -> Developers -> Webhooks
#      subscribed to customer.subscription.{created,updated,deleted}. Copy its
#      signing secret.
#
# For the Price IDs, run once:    python -m pebble.stripe_bootstrap
# It creates "Pebble Starter" ($29/mo) + "Pebble Pro" ($59/mo) products + prices
# in the account STRIPE_SECRET_KEY points at, and prints a paste-ready block.
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PEBBLE_STRIPE_STARTER_PRICE_ID=
PEBBLE_STRIPE_PRO_PRICE_ID=

# OPTIONAL — free trial length in days. Unset or 0 = immediate charge
# at Checkout. Set to a positive integer (e.g. 7) to add Stripe-managed
# trial_period_days to every new subscription. The Customer Portal lets
# users cancel during the trial with no charge.
PEBBLE_TRIAL_DAYS=

# ─────────────────────────────────────────────────────────────────
# INTERNAL KEY — post-first-build email drip (Chapter 11.6)
# ─────────────────────────────────────────────────────────────────
# A random secret that gates GET /api/internal/process-email-drip.
# A Windows scheduled task (see below) calls this endpoint hourly to
# fire due drip emails. Generate once:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then add it to .env AND to the scheduled task command.
#
# Windows scheduled task — run once from an admin PowerShell:
#   schtasks /Create /TN "Pebble Email Drip" /TR "curl -s -H \"X-Internal-Key: <PEBBLE_INTERNAL_KEY>\" http://localhost:8000/api/internal/process-email-drip" /SC HOURLY /ST 00:05
# ─────────────────────────────────────────────────────────────────
PEBBLE_INTERNAL_KEY=

# ─────────────────────────────────────────────────────────────────
# V3 FRONTEND — set in ui/v3/.env.local (not this file)
# ─────────────────────────────────────────────────────────────────
# Base URL for sitemap.xml generation. Must match your production domain.
# NEXT_PUBLIC_BASE_URL=https://getpebble.net
#
# Plausible analytics — add your domain once you've created the site at
# plausible.io. Without this, the script tag is not injected at all.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=getpebble.net
